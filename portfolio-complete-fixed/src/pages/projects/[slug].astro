---
import {render} from 'astro:content';
import type {CollectionEntry} from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import FrameGallery from '../../components/FrameGallery.astro';
import AudioPlayer from '../../components/AudioPlayer.astro';
import ProjectRow from '../../components/ProjectRow.astro';
import {library} from '../../utils/projects';
import {url,media} from '../../utils/media';
export async function getStaticPaths(){const {projects}=await library();return projects.map(project=>({params:{slug:project.data.slug},props:{project}}));}
interface Props {project:CollectionEntry<'projects'>;}
const {project}=Astro.props;const p=project.data;const {Content}=await render(project);
const {projects,categories}=await library();
const related=projects.filter(x=>x.data.slug!==p.slug).sort((a,b)=>Number(b.data.category===p.category)-Number(a.data.category===p.category)).slice(0,3);
---
<BaseLayout title={p.title} description={p.description} image={p.hero||p.cover}>
  <div class="project-top shell"><a class="back-link" href={url('/work/')}>← Back to the archive</a><div class="project-heading"><div><p class="eyebrow">{p.year}</p><h1>{p.title}<span class="wordmark-dot">.</span></h1></div><p>{p.description}</p></div>{p.demo&&<p class="demo-notice">Demonstration project · Sample content to replace with your own work.</p>}</div>
  <div class="project-banner shell"><img src={media(p.hero||p.cover)} alt={p.coverAlt||p.title} width="1600" height="1000" fetchpriority="high"/></div>
  <div class="project-body shell">
    <div class="project-editorial"><div class="project-facts"><p class="eyebrow">PROJECT NOTES</p><dl><dt>Year</dt><dd>{p.year}</dd>{p.role&&<><dt>Role</dt><dd>{p.role}</dd></>}{p.tags.length>0&&<><dt>Tags</dt><dd>{p.tags.join(', ')}</dd></>}{p.credits.map(c=><><dt>{c.label}</dt><dd>{c.value}</dd></>)}</dl>{p.links.map(link=><p><a class="text-link" href={url(link.url)}>{link.label} ↗</a></p>)}</div><div class="prose"><Content/></div></div>
    <VideoEmbed youtube={p.youtube} video={p.video} poster={p.hero||p.cover} title={p.title}/><FrameGallery frames={p.gallery}/><AudioPlayer tracks={p.audio}/>
  </div>
  <ProjectRow title="Continue exploring" projects={related} categories={categories}/>
</BaseLayout>
