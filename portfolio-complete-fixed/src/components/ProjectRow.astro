---
import type {CollectionEntry} from 'astro:content';
import ProjectCard from './ProjectCard.astro';
import {url} from '../utils/media';
interface Props {title:string; subtitle?:string; projects:CollectionEntry<'projects'>[]; categories:CollectionEntry<'categories'>[]; category?:string;}
const {title,subtitle,projects,categories,category}=Astro.props;
---
{projects.length>0 && <section class="project-section shell">
  <div class="section-heading"><div><h2>{title}</h2>{subtitle && <p>{subtitle}</p>}</div><a class="text-link" href={url(`/work/${category ? `?category=${encodeURIComponent(category)}` : ''}`)}>View all <span aria-hidden="true">↗</span></a></div>
  <div class="project-row">{projects.map(project=><ProjectCard project={project} category={categories.find(c=>c.data.slug===project.data.category)?.data.name}/>)}</div>
</section>}
